diff --git a/src/granular/common.py b/src/granular/common.py
index 5687ffa..d31a749 100644
--- a/src/granular/common.py
+++ b/src/granular/common.py
@@ -786,6 +786,11 @@ def _build_audio_sync_settings(resolve_obj, sync_mode=None, channel_number=None,
         settings[resolve_obj.AUDIO_SYNC_RETAIN_EMBEDDED_AUDIO] = bool(retain_embedded_audio)
     if retain_video_metadata is not None:
         settings[resolve_obj.AUDIO_SYNC_RETAIN_VIDEO_METADATA] = bool(retain_video_metadata)
+    # The Resolve object returns None for ANY unknown attribute (no AttributeError), so a misspelled
+    # constant (e.g. AUDIO_SYNC_WAVEFORMS) yields a None key/value and AutoSyncAudio silently returns False.
+    bad = [repr(k) for k, v in settings.items() if k is None or v is None]
+    if bad:
+        return None, {"error": f"AUDIO_SYNC_* constant resolved to None (unknown name on this Resolve version): {bad}"}
     return settings, None
 
 
